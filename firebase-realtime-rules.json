{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid",
        ".validate": "newData.hasChildren(['name', 'role', 'schoolId', 'online'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "role": {
          ".validate": "newData.isString() && (newData.val() === 'director' || newData.val() === 'administrador' || newData.val() === 'profesor')"
        },
        "schoolId": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "online": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber() || newData.val() === null"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "conversations": {
      "$conversationId": {
        ".read": "auth != null && (data.child('participants').child(auth.uid).exists() || !data.exists())",
        ".write": "auth != null && (data.child('participants').child(auth.uid).exists() || !data.exists())",
        "participants": {
          "$participantId": {
            ".validate": "newData.isBoolean() && newData.val() === true"
          }
        },
        "lastMessage": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "lastMessageTime": {
          ".validate": "newData.isNumber()"
        },
        "messages": {
          "$messageId": {
            ".validate": "newData.hasChildren(['senderId', 'senderName', 'recipientId', 'message', 'timestamp', 'read'])",
            "senderId": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "senderName": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "recipientId": {
              ".validate": "newData.isString() && newData.val().length > 0"
            },
            "message": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
            },
            "timestamp": {
              ".validate": "newData.isNumber()"
            },
            "read": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "groups": {
      "$schoolId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "schoolId": {
          ".validate": "newData.isString() && newData.val() === $schoolId"
        },
        "lastMessage": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "lastMessageTime": {
          ".validate": "newData.isNumber()"
        },
        "messages": {
          "$messageId": {
            ".validate": "newData.hasChildren(['senderId', 'senderName', 'senderRole', 'message', 'timestamp'])",
            "senderId": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "senderName": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "senderRole": {
              ".validate": "newData.isString() && (newData.val() === 'director' || newData.val() === 'administrador' || newData.val() === 'profesor')"
            },
            "message": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
            },
            "timestamp": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "auth != null",
        "$notificationId": {
          ".validate": "newData.hasChildren(['from', 'message', 'timestamp', 'read'])",
          "from": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
          },
          "message": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          },
          "read": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
